# --- Takumi backend configuration (copy to .env and edit) ---

# Extraction provider: auto | nvidia | ollama | saved_demo
# auto walks hosted -> local -> saved demo and NEVER silently switches to a paid provider.
TAKUMI_EXTRACTION_PROVIDER=saved_demo

# NVIDIA NIM — default hosted provider, but double-gated on purpose:
# 1) confirm the account's free entitlement first, 2) then set both values.
# Any chat-completions model on build.nvidia.com works, e.g.:
#   TAKUMI_NVIDIA_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
# Reasoning models need more headroom — see TAKUMI_LLM_MAX_TOKENS / TIMEOUT below.
TAKUMI_NVIDIA_API_KEY=
TAKUMI_NVIDIA_ENABLED=false
TAKUMI_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
TAKUMI_NVIDIA_MODEL=meta/llama-3.1-8b-instruct

# Local fallback (portable Ollama)
TAKUMI_OLLAMA_BASE_URL=http://localhost:11434
TAKUMI_OLLAMA_MODEL=qwen2.5:7b

# Transcription
TAKUMI_WHISPER_MODEL=small.en

# Limits
TAKUMI_MAX_RECORDING_SECONDS=600
TAKUMI_MAX_UPLOAD_MB=1000
TAKUMI_LLM_TIMEOUT_SECONDS=60
TAKUMI_LLM_MAX_ATTEMPTS=2
TAKUMI_LLM_MAX_TOKENS=3000
